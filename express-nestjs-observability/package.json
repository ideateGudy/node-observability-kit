{
  "name": "@ideategudy/express-nestjs-observability",
  "version": "0.1.0",
  "description": "Observability package for Express and NestJS with OpenTelemetry, Prometheus metrics, and Winston logging",
  "author": "Goodnews Azonubi <azonubigoodnews@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideateGudy/ideategudy-observability-toolkit.git",
    "directory": "express-nestjs-observability"
  },
  "bugs": {
    "url": "https://github.com/ideateGudy/ideategudy-observability-toolkit/issues"
  },
  "homepage": "https://github.com/ideateGudy/ideategudy-observability-toolkit/tree/main/express-nestjs-observability#readme",
  "license": "MIT",
  "keywords": [
    "observability",
    "opentelemetry",
    "prometheus",
    "winston",
    "express",
    "nestjs",
    "metrics",
    "tracing",
    "monitoring"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js",
      "require": "./dist/express/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "prom-client": "^15.1.3",
    "winston": "^3.17.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "express": ">=4.18.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "express": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
