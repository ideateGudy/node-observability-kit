{
  "name": "@stacklenzz/ui",
  "version": "0.1.0",
  "description": "Stacklenzz developer-first React dashboard component library for backend observability",
  "author": "Goodnews Azonubi <azonubigoodnews@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideateGudy/node-observability-kit.git",
    "directory": "observability-ui"
  },
  "bugs": {
    "url": "https://github.com/ideateGudy/node-observability-kit/issues"
  },
  "homepage": "https://github.com/ideateGudy/node-observability-kit/tree/main/observability-ui#readme",
  "license": "MIT",
  "keywords": [
    "observability",
    "dashboard",
    "react",
    "metrics",
    "monitoring",
    "telemetry",
    "nextjs",
    "express",
    "nestjs"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
